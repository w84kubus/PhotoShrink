<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <!--
      Tylko jako awaryjny dekoder na Windows dla formatów, których SkiaSharp nie obsługuje
      (głównie HEIC ze zdjęć z iPhone'a) — korzysta z kodeków wbudowanych w system Windows
      (GDI+/WIC), więc nie dokładamy tu żadnej własnej licencji na dekodowanie HEVC.
      Na macOS/Linux ta ścieżka nigdy się nie wykonuje (patrz OperatingSystem.IsWindows()).
    -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

</Project>
