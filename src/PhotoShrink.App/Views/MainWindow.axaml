<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoShrink.App.ViewModels"
        xmlns:models="using:PhotoShrink.App.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="760"
        x:Class="PhotoShrink.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="700" Height="760" MinWidth="580" MinHeight="580"
        Icon="/Assets/app.ico"
        DragDrop.AllowDrop="True"
        FontSize="14"
        FontFamily="avares://Avalonia.Fonts.Inter/Inter.ttf#Inter"
        Background="#F3F4F6"
        Foreground="#1F2328"
        Title="PhotoShrink — pomniejszanie zdjęć do maila">

    <Design.DataContext>
        <!-- Tylko dla podglądu w IDE; prawdziwy DataContext ustawiany jest w App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>

        <!-- Karty: białe, zaokrąglone, z delikatnym cieniem -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #14000000, 0 1 2 0 #0F000000"/>
        </Style>

        <!-- Strefa przeciągnij-i-upuść -->
        <Style Selector="Border.dropzone">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #14000000, 0 1 2 0 #0F000000"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.dropzone.active">
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="Background" Value="#EFF6FC"/>
            <Setter Property="RenderTransform" Value="scale(1.012)"/>
        </Style>
        <Style Selector="Border.dropzone.pulse">
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="Background" Value="#ECFDF3"/>
            <Setter Property="RenderTransform" Value="scale(1.025)"/>
        </Style>

        <!-- Baner podsumowania -->
        <Style Selector="Border.summary">
            <Setter Property="Background" Value="#ECFDF3"/>
            <Setter Property="BorderBrush" Value="#86D7A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <!-- Przyciski: pełny, niebieski (główna akcja) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#106EBE"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#C8CBD1"/>
        </Style>

        <!-- Przyciski: obrys, jasne tło (drugorzędna akcja) -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="BorderBrush" Value="#D8DCE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Mały okrągły przycisk "usuń z listy" -->
        <Style Selector="Button.iconbutton">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.iconbutton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FEE2E2"/>
        </Style>

        <!-- Wiersz zdjęcia na liście -->
        <Style Selector="Border.photorow">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.photorow:pointerover">
            <Setter Property="Background" Value="#F7F8FA"/>
        </Style>

    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="16">

        <!-- Strefa przeciągnij-i-upuść -->
        <Border x:Name="DropZoneBorder" Grid.Row="0" Classes="dropzone" Classes.active="{Binding IsDragOver}"
                Padding="24" MinHeight="140">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Border Width="60" Height="60" CornerRadius="30" Background="#E8F3FC" HorizontalAlignment="Center">
                    <TextBlock Text="🖼" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Przeciągnij tutaj zdjęcia albo cały folder"
                           FontSize="18" FontWeight="SemiBold" Foreground="#1F2328"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="albo" FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                <Button Content="Wybierz folder ze zdjęciami…" Classes="primary" Click="OnPickFolderClick"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status + wyczyść -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" FontSize="14" Foreground="#44474D"/>
            <Button Grid.Column="1" Content="Wyczyść listę" Classes="secondary" Command="{Binding ClearPhotosCommand}"
                    IsVisible="{Binding HasPhotos}" Margin="8,0,0,0" Padding="12,7" FontSize="13"/>
        </Grid>

        <!-- Podsumowanie oszczędności po przetworzeniu -->
        <Border Grid.Row="2" Classes="summary" IsVisible="{Binding HasSummary}">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryText}" FontSize="15" FontWeight="SemiBold"
                           Foreground="#0F5132" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                     Height="6" CornerRadius="3" IsVisible="{Binding IsBusy}"/>

        <!-- Lista zdjęć -->
        <Border Grid.Row="4" Classes="card" Padding="8" IsVisible="{Binding HasPhotos}">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Photos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PhotoItem">
                            <Border Classes="photorow" PointerPressed="OnPhotoRowPointerPressed" Cursor="Hand"
                                    ToolTip.Tip="Przeciągnij, żeby załączyć do maila">
                                <Grid ColumnDefinitions="46,*,Auto,Auto" Margin="8,7">
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9"
                                            ClipToBounds="True" Background="#E8F3FC">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Medium"
                                                   Foreground="#1F2328" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#9CA3AF"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding OriginalSizeText}" Foreground="#6B7280"/>
                                        <TextBlock Text="→" Foreground="#C8CBD1"/>
                                        <TextBlock Text="{Binding OutputSizeText}" Foreground="#0078D4" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding SavedText}" Foreground="#16A34A" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="✕" Classes="iconbutton" Command="{Binding RemoveCommand}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Ustawienia (schowane, żeby nie przytłaczać) -->
        <Border Grid.Row="5" Classes="card" Padding="4">
            <Expander Header="Ustawienia" IsExpanded="False" Background="Transparent" BorderThickness="0">
                <StackPanel Margin="4,10,4,4" Spacing="14">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="4">
                            <TextBlock Text="Maks. wymiar zdjęcia (px)" Foreground="#44474D" FontSize="13"/>
                            <NumericUpDown Value="{Binding MaxDimension}" Minimum="100" Maximum="10000"
                                           Increment="10" FormatString="0" IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Maks. rozmiar pliku (MB)" Foreground="#44474D" FontSize="13"/>
                            <NumericUpDown Value="{Binding MaxFileSizeMb}" Minimum="0.1" Maximum="20"
                                           Increment="0.1" FormatString="0.0" IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowExplorerIntegrationOption}">
                        <TextBlock Text="Menu prawego przycisku myszy w Eksploratorze" Foreground="#44474D" FontSize="13"/>
                        <Button Content="{Binding ExplorerIntegrationButtonText}" Classes="secondary"
                                Command="{Binding ToggleExplorerIntegrationCommand}"
                                HorizontalAlignment="Left" Padding="12,8" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Główne akcje -->
        <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0" Content="Pomniejsz zdjęcia" Classes="primary" Command="{Binding StartCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,13" FontSize="15"/>
            <Button Grid.Column="1" Content="Otwórz folder z wynikiem" Classes="secondary"
                    Command="{Binding OpenOutputFolderCommand}" Padding="14,13"/>
        </Grid>

    </Grid>
</Window>
